        "writing",
        "claims",
        "sources",
        "skills",
        "development",
        "review_efficiency",
        "resource_adoption",
        "artifact_prompt"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "receiving": {
          "type": "string"
        },
        "calculation": {
          "type": "string"
        },
        "artifact_checks": {
          "type": "object",
          "required": [
            "文書/メール/提案",
            "表計算/報告",
            "スライド/印刷物",
