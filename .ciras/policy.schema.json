      "additionalProperties": false
    },
    "成功条件": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "evidence"
        ],
        "properties": {
          "id": {
            "enum": [
              "SC1",
              "SC2",
              "SC3",
              "SC4"
            ]
          },
          "text": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "許可範囲": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "boundary"
        ],
        "properties": {
          "id": {
            "enum": [
              "AL1",
              "AL2",
              "AL3",
              "AL4"
