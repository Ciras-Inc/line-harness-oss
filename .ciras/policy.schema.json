    "repository_distribution": {
      "type": "object",
      "required": [
        "status",
        "scope",
        "preservation",
        "source",
        "snapshot",
        "schema",
        "format",
        "release",
        "test"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "preservation": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "snapshot": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "test": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "repository_specific_requirements": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9_.-]{1,100}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "execution_contract": {
      "type": "object",
      "required": [
        "execution_mode",
        "ordinary_action_actor",
        "owner_only_actor",
        "approval_alone_is_sufficient",
        "owner_only_actions",
        "ordinary_execution_conditions",
        "production_actions",
        "ai_preparation_actions",
        "permitted_after_owner_action",
        "preparation_with_production_side_effects",
        "birds_eye_required",
        "objective_checkpoints",
        "identity_boundary",
        "existing_automation_boundary",
        "formal_review_boundary"
      ],
      "properties": {
        "execution_mode": {
          "type": "string",
          "const": "authorized_ordinary_actions_owner_only_adoption"
        },
        "ordinary_action_actor": {
          "type": "string",
          "const": "authorized_ai_or_owner"
        },
        "owner_only_actor": {
          "type": "string",
          "const": "sugimoto"
        },
        "approval_alone_is_sufficient": {
          "type": "boolean",
          "const": false
        },
        "owner_only_actions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "initial-settings-adoption",
              "active-protection-change",
              "repository-owner-only-action",
              "contract-accept"
            ]
          }
        },
        "ordinary_execution_conditions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "same-fixed-version",
              "required-verification-passed",
              "formal-review-satisfied",
              "valid-operation-approval",
              "actual-authority",
              "adopted-route",
              "approved-side-effects",
              "no-stop-or-unknown-outcome"
            ]
          }
        },
        "production_actions": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "string",
            "enum": [
              "merge",
              "publish",
              "deploy",
              "external-send",
              "release",
              "live-data-write",
              "permission-change",
              "sharing-change",
              "new-connection",
              "automation-enable",
              "contract-accept"
            ]
          }
        },
        "ai_preparation_actions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "read-nonsecret",
              "edit-candidate",
              "local-test",
              "prepare-diff",
              "prepare-handoff",
              "authorized-nonpublic-pr"
            ]
          }
        },
        "permitted_after_owner_action": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "nonsecret-readback",
              "compare-result",
              "report"
            ]
          }
        },
        "preparation_with_production_side_effects": {
          "type": "string",
          "const": "effect-specific-authorization"
        },
        "birds_eye_required": {
          "type": "boolean",
          "const": true
        },
        "objective_checkpoints": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "start",
              "material_change",
              "before_review",
              "before_handoff"
            ]
          }
        },
        "identity_boundary": {
          "type": "string"
        },
        "existing_automation_boundary": {
          "type": "string"
        },
        "formal_review_boundary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "owner_handoff_contract": {
      "type": "object",
      "required": [
        "required_fields",
        "readiness_values",
        "minimum_rule",
        "decision_actor",
        "ai_self_score_is_evidence"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "type": "string",
            "enum": [
              "purpose",
              "before",
              "after",
              "changed_and_unchanged",
              "version",
              "target_and_audience",
              "verification",
              "review",
              "side_effects",
              "costs",
              "restoration",
              "owner_steps",
              "open_items",
              "readiness"
            ]
          }
        },
        "readiness_values": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "ready_for_owner_action",
              "hold_for_specific_dependency",
              "not_applicable"
            ]
          }
        },
        "minimum_rule": {
          "type": "string"
        },
        "decision_actor": {
          "type": "string",
          "const": "sugimoto"
        },
        "ai_self_score_is_evidence": {
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ciras-Inc/ciras-os/policy.schema.json",
  "title": "Ciras AI policy distribution schema"
}
