          "properties": {
            "pass": {
              "type": "string"
            },
            "fail": {
              "type": "string"
            },
            "unverified": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "technical_control_requirements": {
