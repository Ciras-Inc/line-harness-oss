          "text": {
            "type": "string"
          },
          "boundary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "禁止の正本（JSON参照）": {
      "type": "object",
      "required": [
        "canonical_file",
        "group_order",
        "rules"
      ],
      "properties": {
        "canonical_file": {
          "type": "string"
        },
        "group_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "type": "object",
            "required": [
              "id",
              "group",
              "decision",
              "scope",
              "approved_behavior"
            ],
            "properties": {
              "id": {
                "enum": [
                  "S01",
                  "C01",
                  "A01-SELF",
                  "R01",
                  "G01",
                  "G02",
                  "G03",
                  "D01",
                  "P01",
                  "N01",
                  "B01",
                  "B02-CONTRACT",
                  "A01-CHANGE",
                  "SW01"
                ]
              },
              "group": {
                "type": "string"
              },
              "decision": {
                "enum": [
                  "stop_and_return",
                  "stop_unauthorized_import",
                  "approval_required",
                  "owner_execution_only",
                  "authorized_specific_request"
                ]
              },
              "scope": {
                "type": "string"
              },
              "approved_behavior": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "止めて返すもの": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "承認待ち": {
      "type": "object",
      "required": [
        "classes",
        "approval_binding",
